    "item":  [
                 {
                     "name":  "Estado de la API y la base de datos",
                     "request":  {
                                     "method":  "GET",
                                     "url":  "{{baseUrl}}/api/estado"
                                 },
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\u0027Responde 200\u0027, () =\u003e pm.response.to.have.status(200));",
                                                                   "pm.test(\u0027PostgreSQL con 11 tablas\u0027, () =\u003e pm.expect(pm.response.json().tablas).to.eql(11));"
                                                               ]
                                                  }
                                   }
                               ]
                 },
