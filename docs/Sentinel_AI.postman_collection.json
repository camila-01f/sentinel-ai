                                                                                    "pm.test(\u0027Fuente REGLAS\u0027, () =\u003e pm.expect(r.fuente).to.eql(\u0027REGLAS\u0027));",
                                                                                    "pm.test(\u0027Estructura caida\u0027, () =\u003e pm.expect(r.categoriaId).to.eql(4));",
                                                                                    "pm.test(\u0027Prioridad alta\u0027, () =\u003e pm.expect(r.prioridadId).to.eql(2));"
